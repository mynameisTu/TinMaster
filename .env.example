# Server-only. Configure locally in .env or in the Vercel project environment.
# Never expose this key through a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Document extraction defaults to gemini-3.8-flash. Configure a fallback only
# after confirming it is enabled for this API key; gemini-2.5-flash is a
# compatible Gemini API model for PDF/image input and JSON output.
# GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
# GEMINI_ATTEMPT_TIMEOUT_MS="30000"
# GEMINI_EXTRACTION_DEADLINE_MS="180000"

# Public Supabase browser configuration. These values are not secrets.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
# Exact browser origins allowed in OAuth and password-reset redirects.
# Add localhost plus each required Vercel Preview/Production origin.
VITE_AUTH_ALLOWED_ORIGINS="https://tinmaster.example.com,https://tinmaster-preview.vercel.app"

# Never expose a service-role key through VITE_ variables. Not required by the
# current browser-authentication flow.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
# Gemini endpoint limits are stored per endpoint in private.api_rate_limit_config
# by the Supabase migration; adjust those rows with privileged SQL, not env vars.
SUPABASE_UPLOAD_BUCKET="exercise-uploads"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"

# Server-only. Configure locally in .env or in the Vercel project environment.
# Never expose this key through a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Future private Supabase Storage integration; not read by the app yet.
# Keep the service-role key on the server only. The anon key is public but must
# be paired with correct Supabase Auth and Storage policies when integrated.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"
SUPABASE_UPLOAD_BUCKET="exercise-uploads"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
